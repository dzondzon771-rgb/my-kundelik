rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff roles and department memberships are set manually in Firebase
    // by the PROJECT OWNER, never by students or the department head.
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function staffPath() {
      return /databases/$(database)/documents/staffRoles/$(request.auth.uid);
    }
    function isHeadFor(departmentId) {
      return signedIn()
        && exists(staffPath())
        && get(staffPath()).data.role == 'department_head'
        && get(staffPath()).data.departmentId == departmentId;
    }
    function mayReadReport(studentUid) {
      return signedIn()
        && exists(staffPath())
        && get(staffPath()).data.role == 'department_head'
        && get(staffPath()).data.departmentId is string
        && exists(/databases/$(database)/documents/departments/$(get(staffPath()).data.departmentId)/members/$(studentUid));
    }

    // Full private diary: ONLY account owner may read or write.
    match /users/{uid}/private/{docId} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is map;
      allow delete: if isOwner(uid);
    }

    // Public-to-the-department REPORT projection (not full diary or notes).
    match /reports/{studentUid} {
      allow get: if isOwner(studentUid) || mayReadReport(studentUid);
      allow list: if false;
      allow create, update: if isOwner(studentUid)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.data.keys().hasOnly(['group', 'leader', 'students', 'attendance'])
        && request.resource.data.data.group is string
        && request.resource.data.data.leader is string
        && request.resource.data.data.students is list
        && request.resource.data.data.attendance is map;
      allow delete: if isOwner(studentUid);
    }

    // A regular account cannot create a privileged role.
    match /staffRoles/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    // Only staff with an exact matching department may see its members.
    match /departments/{departmentId}/members/{starostaUid} {
      allow get, list: if isHeadFor(departmentId);
      allow create, update, delete: if false;
    }
  }
}
