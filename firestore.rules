rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function staffPath(uid) { return /databases/$(database)/documents/staffRoles/$(uid); }
    function departmentHead(deptId) {
      return signedIn()
        && exists(staffPath(request.auth.uid))
        && get(staffPath(request.auth.uid)).data.role == 'department_head'
        && get(staffPath(request.auth.uid)).data.departmentId == deptId;
    }
    function canReadReport(ownerUid) {
      return self(ownerUid)
        || (signedIn()
          && exists(staffPath(request.auth.uid))
          && get(staffPath(request.auth.uid)).data.role == 'department_head'
          && get(staffPath(request.auth.uid)).data.departmentId is string
          && exists(/databases/$(database)/documents/departments/$(get(staffPath(request.auth.uid)).data.departmentId)/members/$(ownerUid)));
    }
    match /users/{uid} {
      allow get: if self(uid);
      allow list: if false;
      allow create, update, delete: if self(uid);
      match /private/{docName} {
        allow get, list: if self(uid);
        allow create, update, delete: if self(uid);
      }
    }
    match /reports/{uid} {
      allow get: if canReadReport(uid);
      allow list: if false;
      allow create, update, delete: if self(uid);
      match /lateArrivals/{entryId} {
        allow get, list: if canReadReport(uid);
        allow create, update: if self(uid)
          && request.resource.data.keys().hasOnly(['date','studentId','name','time'])
          && request.resource.data.keys().hasAll(['date','studentId','name','time'])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.studentId is string
          && request.resource.data.name is string
          && request.resource.data.time is string
          && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
        allow delete: if self(uid);
      }
    }
    match /staffRoles/{uid} {
      allow get: if self(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /departments/{deptId} {
      allow get: if departmentHead(deptId);
      allow list: if false;
      allow create, update, delete: if false;
      match /members/{starostaUid} {
        allow get, list: if departmentHead(deptId);
        allow create, update, delete: if false;
      }
    }
  }
}
